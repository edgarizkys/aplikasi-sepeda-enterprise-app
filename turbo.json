{
  "$schema": "https://turbo.build/schema.json",
  "version": "1",
  "globalDependencies": [
    "**/.env",
    "**/.env.local",
    "**/.env.*.local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ],
      "cache": true,
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "interactive": true,
      "dependsOn": [
        "^dev"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "type-check": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL"
      ]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "db:migrate"
      ],
      "env": [
        "DATABASE_URL"
      ]
    },
    "db:studio": {
      "cache": false,
      "interactive": true
    }
  },
  "pipeline": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "lint",
        "type-check"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "type-check": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    }
  },
  "ui": "tui"
}