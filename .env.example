# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sepeda_enterprise"

# JWT
JWT_ACCESS_SECRET="your_access_token_secret_key_min_32_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_refresh_token_secret_key_min_32_chars_long"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Encryption
BCRYPT_ROUNDS=10

# Multi-tenancy
DEFAULT_TENANT_ID="default-tenant"

# Logging
LOG_LEVEL="info"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@sepedaenterprise.com"

# Payment Gateway (optional)
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"
UPLOAD_DIR="./uploads"

# Session
SESSION_SECRET="your_session_secret_key_min_32_chars_long"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100