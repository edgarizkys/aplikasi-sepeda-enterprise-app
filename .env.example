# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sepeda_enterprise"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3000
NODE_ENV="development"
API_URL="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="Aplikasi Sepeda Enterprise"
NEXT_PUBLIC_DOMAIN="bike_enterprise"

# Email (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@sepedaenterprise.com"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# Logging
LOG_LEVEL="info"

# CORS
CORS_ORIGIN="http://localhost:3001"

# Session
SESSION_SECRET="your-session-secret-key-min-32-characters"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100